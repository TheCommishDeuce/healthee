# Build configuration for the Flutter app.
#
#   cp build.env.example build.env      # then fill it in; build.env is gitignored
#   flutter build apk --release --dart-define-from-file=build.env
#   flutter run --dart-define-from-file=build.env
#
# Everything here DESCRIBES THE BUILD; nothing here identifies an owner. That is
# `lib/core/env.dart`'s rule and it is the whole difference between this app and
# the legacy one, which baked a strap MAC and a pairing key into every APK.
#
# ⚠ Do not quote the values. This file is read as KEY=value, so quotes end up
# inside the string — and a base URL wrapped in quotes fails to parse as a URI
# with an error that says nothing about quotes.

# Where the owner's Healthee server is.
HELIO_API=https://healtheeapi.example.com

# ── the identity provider ───────────────────────────────────────────────────
# Both or neither. Half a configuration is a sign-in form that submits into a
# 400 and reports the owner's password as the problem; `Env.hasIdentityProvider`
# requires both, and a build with neither offers the transitional token form and
# says why.

# Supabase dashboard → Project Settings → Data API → Project URL.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Same page → Project API keys → the `anon` / `public` key.
#
# Publishable by design: it identifies the project and authorises nothing on its
# own — Supabase's own documentation says it is meant to ship inside clients.
#
# ⛔ NEVER the `service_role` key. That one bypasses every row-level policy and
# belongs only in the server's `infra/.env`, where it is already configured as
# SUPABASE_SERVICE_ROLE_KEY. A build is not a place you can take a key back from.
SUPABASE_ANON_KEY=YOUR-ANON-KEY

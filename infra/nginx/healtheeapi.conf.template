# A TEMPLATE, not a usable vhost. `${PUBLIC_HOST}` is substituted at render time.
#
#   infra/nginx/render-vhost.sh            # prints the rendered vhost
#   infra/nginx/render-vhost.sh --install  # writes it to sites-available + links
#
# `PUBLIC_HOST` comes from `infra/.env`, which is where every other
# deployment-specific value already lives and is gitignored. Nobody edits a
# tracked file to deploy, and no operator's own domain lands in this repository —
# that is the whole point of the indirection.
#
# ⚠ `PUBLIC_HOST` is NOT `API_HOST`. `API_HOST` is the bind address INSIDE the
# container (0.0.0.0); this is the public DNS name the world resolves. Two
# different questions that both sound like "the host".
#
# Reverse-proxies https://${PUBLIC_HOST} -> 127.0.0.1:8765 (api container).
#
# TLS: this renders the plain :80 vhost. Run certbot AFTER enabling it:
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d "$PUBLIC_HOST"
# certbot rewrites the INSTALLED file in place, adding the :443 listener + cert
# paths and an http->https redirect. Renewal is automatic via its systemd timer.
#
# ⛔ Which is why re-rendering over a live vhost DESTROYS TLS: the installed file
# is certbot's, and this template is the pre-certbot :80 one. `--install` refuses
# to overwrite a file containing a 443 listener for exactly that reason, and
# nothing in `deploy.sh` installs a vhost at all.
#
# ⚠ The :443 server block that actually serves traffic therefore exists only on the
# box. The file under review here is not the file in force, which is why the security
# headers below sit inside the server block certbot copies rather than in a snippet,
# and why HSTS is NOT set here: it belongs to the TLS listener, and asserting it from
# the plain :80 vhost would be a claim this file cannot keep.

# Per-IP request budget for the API. There was no `limit_req` and no `limit_conn`
# anywhere: the only unauthenticated routes are /healthz and /readyz, and both run a
# `SELECT 1` on a pool whose max size is 10, so the exposure was pool exhaustion by
# anybody at all — and an authenticated caller could hammer /ingest/helio as fast as it
# would answer. The rate comes from what the CLIENT does, not from a feeling: a full
# drain is at most `maxPages` 20 x `maxDrainRounds` 12 sequential POSTs
# (`apps/mobile/lib/data/push/push_service.dart`), and a screen load is a handful of
# GETs. 20 r/s with a burst of 100 is far above either and still a bound.
limit_req_zone $binary_remote_addr zone=healthee_api:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=healthee_conn:10m;

server {
    listen 80;
    listen [::]:80;
    server_name ${PUBLIC_HOST};

    # Cloudflare real-IP — restore the client IP when behind the orange cloud.
    # Safe to leave even if DNS-only. Refresh ranges from
    # https://www.cloudflare.com/ips/ periodically.
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    real_ip_header CF-Connecting-IP;

    # The largest body this API accepts is a full ingest page or a GPS track, and both
    # are bounded by the models: 4,000 samples a page
    # (`push_reader.kPushSampleLimit`) is a few hundred KB of JSON, and
    # `GpsTrackIn.points` caps at 28,800 points, ~1 MB. 8 MB is an order of magnitude
    # above either.
    #
    # It was 600M, for a reason that no longer exists: "Multipart uploads
    # (Gadgetbridge .db) can be large once history builds up." **This application has
    # no multipart upload route** — no `UploadFile`, no multipart handler anywhere in
    # `apps/server/src/`. The limit was a carry-over from the previous implementation
    # and it applied to `/ingest/helio` and `/api/coach` equally. If a large-upload
    # path is ever added, scope the large limit to that `location`, not to `/`.
    client_max_body_size 8M;

    # Sent on every response, including the :443 one certbot builds from this block.
    # `always` so they are present on error responses too, which is where a missing
    # nosniff actually bites.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # Long-running ingests can take 30s+ on big payloads.
    proxy_read_timeout  180s;
    proxy_send_timeout  180s;

    location / {
        # `nodelay` so a normal burst (a screen load, a sync drain) is served at once
        # and only a sustained flood is slowed. `limit_req_status` says 429 rather than
        # nginx's default 503, because "you are asking too fast" and "the service is
        # down" are different answers and a client acts on them differently.
        limit_req zone=healthee_api burst=100 nodelay;
        limit_req_status 429;
        limit_conn healthee_conn 24;
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Liveness shortcut — no auth, for uptime monitors and deploy.sh.
    location = /healthz {
        proxy_pass http://127.0.0.1:8765/healthz;
        access_log off;
    }

    # Basemap tiles. `access_log off` is not tidiness here — the PATH is the
    # payload: /api/map/tiles/17/x/y names a street corner, and a log of them
    # beside a timestamp is a location history of whoever is running. The whole
    # reason the app asks this server for tiles instead of a provider is that no
    # third party should be able to assemble that; writing it into our own access
    # log would just move the file. The app does the same for uvicorn's access
    # log (core/logging.silence_access_log_for).
    location /api/map/tiles/ {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }
}

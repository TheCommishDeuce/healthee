# Healthee — Dockge stack env. Copy to `.env` in the stack dir and fill in.
#
# Dockge edits this file through its UI, and `compose.yaml` passes the WHOLE file
# into every container (`env_file:`), so a var set here reaches the process. That is
# the point: the old per-service `environment:` lists could and did drift, leaving
# vars documented, set on the box, and never received.
#
# Every name below is read by `core/config.Settings` except the clearly-marked
# DEPLOY-ONLY block at the end. Long-form reasoning for each value lives in
# `infra/.env.example`, which stays the reference; this file is the operational copy.
#
# Generate secrets: openssl rand -base64 48 | tr -d '/+=' | head -c 32

# ═══ Image + Traefik (deploy-only — not read by the app) ═════════════════
# WHERE the image comes from. REQUIRED — `compose.yaml` refuses to start without it
# rather than defaulting to somebody's namespace, because the namespace it would have
# to default to is the upstream project's, and silently running an image you did not
# build is not a sane fallback.
#
# ⚠ MUST BE LOWERCASE. A registry path with a capital in it is rejected, and a GitHub
# username very often has one (`TheCommishDeuce` → `thecommishdeuce`).
#
# Three ways to have an image — infra/dockge/README.md, "Where the image comes from":
#
#   fork    ghcr.io/<your-github-user>/healthee-api   (CI publishes here by itself)
#   own     registry.example.com/healthee-api         (any registry you can push to)
#   local   healthee-api                              (built on the box; also set
#                                                      HEALTHEE_BUILD_LOCALLY=true)
HEALTHEE_IMAGE=ghcr.io/thecommishdeuce/healthee-api

# The tag the stack runs. `main` moves with every push to main, which is what
# gives Dockge's update button something to pull. Pin to `sha-<short>` to freeze
# a known-good build or to roll back — `docker image ls` on the box lists what
# has been pulled, and the registry's package page lists the rest.
HEALTHEE_IMAGE_TAG=main

# Build on the VPS from the repo checkout instead of pulling a published image.
# `true` makes infra/dockge/deploy.sh build before it deploys. Use it when you have
# no registry to publish to. ⚠ Dockge's update button CANNOT build — it only pulls —
# so with this set every update goes through deploy.sh.
HEALTHEE_BUILD_LOCALLY=false

# ═══ The private-network address Traefik dials ════════════════════════
# ⛔ THIS BOX'S PRIVATE IP, and the security boundary of the whole deployment.
#
# Traefik runs on a DIFFERENT machine, so the api port has to be reachable across
# your private network — it cannot be 127.0.0.1 the way it was under same-host
# nginx. Whatever can reach this address talks to the app with NO TLS, NO rate
# limit and a bearer token as the only check.
#
#   ✓ 10.0.0.5        this box on the private network
#   ✗ 0.0.0.0         the API, on the public internet, unprotected
#   ✗ 127.0.0.1       unreachable from Traefik; healthy stack, 502 site
#
# ⚠ Docker writes its own iptables rules AHEAD of ufw, so `ufw deny 8765` does NOT
# protect a 0.0.0.0 bind. The bind address IS the control. Required — compose
# refuses to start without it rather than picking one of the wrong answers.
#
# Find it: `ip -4 addr` and take the address on the private interface (Hetzner
# ens10 / DO eth1 / a tailscale0 100.x address — not eth0's public one).
HEALTHEE_BIND_ADDR=10.0.0.5

# Which IP the rate limiter counts against. 0 = the TCP peer.
# ⚠ Behind Cloudflare, 0 means every visitor shares ONE bucket and a single user's
# sync throttles the whole world. Set 1 there — and trust the CF ranges on the
# entrypoint too, or Traefik overwrites the header it would read.
# Read by infra/traefik/render-dynamic.sh, not by this stack. See CHECKLIST.md §1.
TRAEFIK_IP_DEPTH=0

# NOTE: the entrypoint and the cert resolver are NOT here. They belong to the
# Traefik host's own config, not to this box — see infra/traefik/healthee.yml.template.

# The public name this deployment answers on. A bare hostname: no scheme, no port,
# no path. It becomes Traefik's Host() rule and the cert's subject.
# ⚠ NOT API_HOST, which is the bind address inside the container.
PUBLIC_HOST=healtheeapi.example.com

# ═══ Postgres / TimescaleDB ══════════════════════════════════════════════
# POSTGRES_HOST/PORT are pinned to the compose network in compose.yaml and cannot
# be overridden from here — they are topology, not choice. Declared for completeness.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=healthee
# The OWNER/ADMIN identity: creates the DB, owns the tables, runs migrations and
# provision_app_role. NOT what the request pool connects as.
POSTGRES_USER=healthee
POSTGRES_PASSWORD=change-me-please

# ─── The least-privilege role the app pool uses (MULTI_USER.md §3.3) ─────
# DML on the data tables only — NOSUPERUSER, NOBYPASSRLS. It exists because a
# SUPERUSER bypasses Row-Level Security unconditionally, which would make §3.3's
# policies test green and protect nothing.
#
# ⚠ Bootstrapping these is TWO deploys, in this order (infra/DEPLOY.md B2):
#   1. both blank + ALLOW_ADMIN_DB_FALLBACK=true — the app stays up on admin creds;
#   2. set both, remove the fallback, run infra/deploy.sh — it provisions the role
#      as the admin BEFORE recreating the app;
#   3. confirm the startup log says "connected as least-privilege role".
# Setting these while the role does not exist means the app cannot authenticate at all.
POSTGRES_APP_USER=healthee_app
POSTGRES_APP_PASSWORD=change-me-please
# `true` says "this deployment knowingly runs on a role that bypasses RLS". Step 1
# above and nothing else.
ALLOW_ADMIN_DB_FALLBACK=false

# ═══ FastAPI bind (inside the container) ═════════════════════════════════
# Pinned in compose.yaml. Declared here so the inventory is complete.
API_HOST=0.0.0.0
API_PORT=8765

# ═══ Logging ═════════════════════════════════════════════════════════════
LOG_LEVEL=INFO

# ═══ Supabase identity (MULTI_USER.md §4) ════════════════════════════════
# The API only VERIFIES the access JWT; it never mints one. A blank secret fails
# auth CLOSED — every JWT is refused.
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Blank project ref ⇒ the `iss` check is skipped (dev / self-signed tokens).
SUPABASE_PROJECT_REF=
SUPABASE_JWT_AUD=authenticated
# Served unauthenticated by GET /api/auth-config — a client needs these BEFORE it
# can sign in. Both are public by construction.
# ⛔ NEVER the service-role key here; that one bypasses every policy.
# Blank URL derives https://<SUPABASE_PROJECT_REF>.supabase.co.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ═══ Signup gating (MULTI_USER.md §4, §13) ═══════════════════════════════
# Enforced by the SERVER, gating NEW accounts only. Uncontrolled signup is
# uncontrolled LLM spend. Comma-separated, case-insensitive.
SIGNUPS_OPEN=false
SIGNUP_ALLOWLIST=

# ═══ Entitlement (MULTI_USER.md §12) ═════════════════════════════════════
# The AI layer is premium; the tracker is free. Entitlement lives in the
# `subscription` table (`python -m healthee.db.grant_premium`), not here.
# This flag is the one deployment-wide override — true only on a SELF-HOSTED box
# where the LLM bill is the operator's own.
SELF_HOST_UNLOCKED=false
# Coach questions a PREMIUM owner gets per rolling 30 days. **0 means unlimited**,
# which is the honest setting on a box whose owner pays their own bill.
PREMIUM_COACH_QUESTIONS=20
UPGRADE_URL=

# ═══ OpenRouter (optional — the grounded LLM layer) ══════════════════════
# ⚠ The api, scheduler AND preflight REFUSE TO START with the key set and either
# model id blank — a blank id is forwarded verbatim and comes back 400, which is a
# dead AI layer behind a green /healthz. Leave all three blank to deploy without it.
# ⚠ Quote any value containing a space or a shell metacharacter. Compose strips the
# quotes; a bare `<` or an unquoted space breaks anything that reads this file.
OPENROUTER_API_KEY=
DEFAULT_MODEL="<provider>/<cheap-model-id>"
COACH_MODEL="<provider>/<stronger-model-id>"
# How the coach spends THINKING: on | off | answer_only.
COACH_REASONING=on
# Bound on ONE call and its retries. Unset, the SDK uses 600 s × 2 = 30 minutes of
# hang, and the scheduler is a single-threaded tick loop — one stuck call blocks
# every later owner's chain.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1
# The WALL-CLOCK cap on one completion — different from the read timeout above,
# which only fires when the socket goes silent. OpenRouter's keepalive bytes mean
# it often never does.
LLM_DEADLINE_S=120
# How long one grounded run may spend running TOOLS before it must answer with what
# it has. Hitting it is not an abort — the next turn answers and says what it lacks.
GATHERING_DEADLINE_S=150
# Dollars below which the scheduler WARNS to Telegram. Only a warning; nothing
# declines to spend. 0 disables it, leaving only the "exhausted" alert, which fires
# when it is already too late.
LLM_LOW_BALANCE_USD=20
# Nudged rewrites one generated answer gets before the honest fallback ships. Only
# a candidate that ALREADY failed its gates spends one.
LLM_VALIDATION_RETRIES=2
# Ordered OpenRouter provider tags the COACH tier prefers. Empty = OpenRouter's own
# routing. Pinning is an operator decision, measured on your own traffic — not one
# inherited by copying a file, which is why this ships empty.
LLM_PROVIDER_ORDER=
LLM_PROVIDER_SORT=throughput

# ═══ Caches (on the healthee-geocache volume) ════════════════════════════
# Public geodata only — squares of the world this server fetched, never an owner's
# coordinates.
SRTM_CACHE_DIR=/var/cache/healthee/srtm
MAP_TILE_CACHE_DIR=/var/cache/healthee/tiles
MAP_TILE_CACHE_MB=512
# The QUERY-time ONNX model only (69 MB). The corpus PASSAGE matrix is a committed
# artifact (packages/knowledge/embeddings/); this box never embeds the corpus.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=/var/cache/healthee/embeddings

# ═══ Coach evidence budget ═══════════════════════════════════════════════
EVIDENCE_TOKEN_BUDGET=8000
# ⚠ Measured at ~3.5 s mean / ~5.1 s p95 PER QUESTION on 4 CPUs, +104 MB RSS —
# roughly 10× what this deployment can spend. Off by default; re-measure on YOUR
# box before turning it on.
EVIDENCE_RERANK=false

# ═══ Basemap provider ════════════════════════════════════════════════════
# The phone NEVER talks to a tile provider: it asks this server, which fetches and
# caches. That is what keeps the area the owner exercises in off a third party's
# logs. Must be http(s) and carry {z} {x} {y}.
# ⚠ CHANGE THE ATTRIBUTION WITH IT — it is served by GET /api/map and drawn on
# screen, and the app cannot tell that a repointed url needs a different credit.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# QUOTED, and it has to be: the value contains spaces. Unquoted, every tool that
# reads this file shell-style runs `OpenStreetMap` as a command.
MAP_TILE_ATTRIBUTION="© OpenStreetMap contributors"
MAP_TILE_MIN_ZOOM=1
MAP_TILE_MAX_ZOOM=17

# ═══ Telegram notifications (optional) ═══════════════════════════════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══ DEPLOY-ONLY — read by scripts on the box, never by the app ══════════
# Branch infra/deploy.sh resets the checkout to; it aborts if local != origin.
DEPLOY_BRANCH=main
# Where dated .sql.gz dumps are written, and how long they are kept.
BACKUP_DIR=/var/backups/healthee
BACKUP_RETENTION_DAYS=30
# Optional off-box copy: a command run with the dump path substituted for {}.
# Example: OFFBOX_CMD="rclone copy {} remote:healthee-backups"
OFFBOX_CMD=
